# TTS Tool Configuration Template
# Copy this file to .env and fill in your actual values

# 火山引擎基础认证
VOLCENGINE_REGION=cn-north-1

# 火山引擎豆包大模型（兼容OpenAI SDK）
ARK_API_KEY=your_ark_api_key_here
VOLCENGINE_ARK_API_KEY=your_volcengine_ark_api_key_here  
VOLCENGINE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 火山引擎语音服务
VOLCENGINE_SPEECH_APP_ID=your_speech_app_id_here
VOLCENGINE_SPEECH_CLUSTER=volcano_tts

# 语音服务统一认证（ASR和TTS共用）
VOLCENGINE_SPEECH_ACCESS_TOKEN=your_access_token_here
VOLCENGINE_SPEECH_SECRET_KEY=your_secret_key_here

# TTS服务资源ID配置
VOLCENGINE_TTS_RESOURCE_ID=volc.service_type.10029

# TTS音色配置
VOLCENGINE_TTS_VOICE_TYPE=BV700_V2_streaming

# Application Settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Output Settings
OUTPUT_DIR=./output
MAX_TEXT_LENGTH=10000
CONCURRENT_REQUESTS=3