        "note": "wav不支持流式"
      },
      "compression_rate": {
        "description": "opus格式时编码压缩比",
        "required": false,
        "type": "int",
        "default": 1,
        "range": [1, 20]
      },
      "speed_ratio": {
        "description": "语速",
        "required": false,
        "type": "float",
        "default": 1.0,
        "range": [0.2, 3.0],
        "note": "通常保留一位小数即可"
      },
      "volume_ratio": {
        "description": "音量",
        "required": false,
        "type": "float",
        "default": 1.0,
        "range": [0.1, 3.0],
        "note": "通常保留一位小数即可"
      },
      "pitch_ratio": {
        "description": "音高",
        "required": false,
        "type": "float",
        "default": 1.0,
        "range": [0.1, 3.0],
        "note": "通常保留一位小数即可"
      },
      "emotion": {
        "description": "情感/风格",
        "required": false,
        "type": "string",
        "note": "参见发音人参数列表"
      },
      "language": {
        "description": "语言类型",
        "required": false,
        "type": "string",
        "note": "参见发音人参数列表"
      }
    },
    "request": {
      "text": {
        "description": "合成语音的文本",
        "required": true,
        "type": "string",
        "max_length": 1024,
        "note": "长度限制1024字节(UTF-8编码)，复刻音色无此限制但HTTP接口有60s超时限制"
      },
      "text_type": {
        "description": "文本类型",
        "required": false,
        "type": "string",
        "default": "plain",
        "options": ["plain", "ssml"]
      },
      "silence_duration": {
        "description": "句尾静音时长(ms)",
        "required": false,
        "type": "int",
        "default": 125
      },
      "operation": {
        "description": "操作类型",
        "required": true,
        "type": "string",
        "options": ["query", "submit"],
        "note": "query为非流式(HTTP只能query)，submit为流式"
      },
      "with_frontend": {
        "description": "时间戳相关",
        "required": false,
        "type": "int",
        "options": [0, 1],
        "note": "当为1且frontend_type为unitTson时返回音素级时间戳"
      },
      "frontend_type": {
        "description": "时间戳类型",
        "required": false,
        "type": "string",
        "default": "unitTson",
        "note": "配合with_frontend=1使用"
      },
      "with_timestamp": {
        "description": "新版时间戳参数",
        "required": false,
        "type": "int",
        "options": [0, 1],
        "note": "传入1时启用，返回原文本时间戳(保留阿拉伯数字/特殊符号)，小语种音色暂不支持"
      },
      "split_sentence": {
        "description": "复刻音色语速优化",
        "required": false,
        "type": "int",
        "options": [0, 1],
        "note": "仅复刻音色时设为1，可优化语速过快问题，可能导致时间戳多次返回"
      },
      "pure_english_opt": {
        "description": "英文前端优化",
        "required": false,
        "type": "int",
        "options": [0, 1],
        "note": "为1时中文音色读纯英文可正确处理阿拉伯数字"
      }
    },
    "extra_param": {
      "disable_emoji_filter": {
        "description": "emoji不过滤显示",
        "required": false,
        "type": "bool",
        "default": false,
        "note": "开启后emoji表情不过滤显示，建议配合时间戳参数使用"
      }
    }
  }
