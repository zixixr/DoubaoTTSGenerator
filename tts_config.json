  "options": {
    "audio": {
      "voice_type": {
        "description": "音色类型",
        "required": true,
        "type": "string",
        "examples": ["zh_female_qingxin", "zh_male_chunhou", "复刻音色ID"]
      },
      "rate": {
        "description": "音频采样率",
        "required": false,
        "type": "int",
        "default": 24000,
        "options": [8000, 16000, 24000]
      },
      "encoding": {
        "description": "音频编码格式",
        "required": false,
        "type": "string",
        "default": "pcm",
